# ===========================================
# HOUSEYE.COM — Environment Variables
# Copy to .env.local and fill real values
# ===========================================

# App

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database

MONGODB_URI=mongodb://localhost:27017/houseye
MONGODB_DB_NAME=houseye

# Auth / Session
AUTH_SECRET=generate-a-long-random-secret-min-32-chars
JWT_SECRET=generate-another-long-random-secret
SESSION_MAX_AGE=2592000

# Super Admin bootstrap (first run only)
SUPER_ADMIN_EMAIL=admin@houseye.com
SUPER_ADMIN_PASSWORD=ChangeThisImmediately123
SUPER_ADMIN_NAME=Houseye Super Admin

# AWS S3 (private storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=houseye-private

# Notification Providers (Super Admin configured)
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@houseye.com

SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=HOUSEYE

WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Payment Gateway (optional for tenant payments)
PAYMENT_GATEWAY=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Subscription Payment (Houseye billing)
SUBSCRIPTION_GATEWAY=
SUBSCRIPTION_KEY=
SUBSCRIPTION_SECRET=
SUBSCRIPTION_WEBHOOK_SECRET=

# Rate limiting / security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Dev: allow subscription activate without payment gateway
ALLOW_DEV_SUBSCRIPTION=true


# Cron / background jobs
CRON_SECRET=change-me-in-production

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (alternative to SMTP)
RESEND_API_KEY=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# App environment: development | staging | production
APP_ENV=development

# Encrypt Owner gateway secrets at rest (required in production)
GATEWAY_ENCRYPTION_KEY=generate-a-long-random-string-min-32-chars


# Optional multi-instance rate limit
REDIS_URL=

